NODE_ENV=development
SERVICE_PORT=4001
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/threadline
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
OTP_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
DATA_ENCRYPTION_KEY=use-the-same-base64-32-byte-key-as-admin
PRIVATE_UPLOADS_DIR=../../private_uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Online payments (customer checkout). Use rzp_test_ keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_ID=
UPI_PAYEE_NAME=Threadline

# SMS + email for OTPs and order codes. Every code is generated by the API and sent as a normal SMS/email.
# SMS: SMS_PROVIDER=fast2sms with FAST2SMS_API_KEY (Fast2SMS dashboard > Dev API), or android (see below).
# Email: SMTP_* above. For Gmail use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and an App Password.
# fast2sms or android (your own phone, see below)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
# Android phone as a free SMS gateway: texts go out from your own SIM, no SMS company or fees. Install
# "SMS Gateway for Android" (https://sms-gate.app) on a phone with an SMS plan, turn on Local Server, and copy the
# address, username and password it shows. The phone must stay on, on the same Wi-Fi as this computer. With
# SMS_PROVIDER=android every SMS uses the phone, sign-up/login codes included. Test with: npm run sms:test -- 98XXXXXXXX
ANDROID_SMS_URL=
ANDROID_SMS_USER=
ANDROID_SMS_PASSWORD=
# Until real credentials are set, print messages in the API console instead (ignored in production).
OTP_DEV_CONSOLE=false

# PhonePe payment gateway (UPI checkout). Client ID / secret / version from the PhonePe Business dashboard,
# Developer Settings. PHONEPE_ENV=sandbox for test keys, production for live keys.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox
