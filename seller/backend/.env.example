NODE_ENV=development
SERVICE_PORT=4001
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/threadline
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
OTP_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
DATA_ENCRYPTION_KEY=use-the-same-base64-32-byte-key-as-admin
PRIVATE_UPLOADS_DIR=../../private_uploads

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Online payments (customer checkout). Use rzp_test_ keys while developing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_ID=
UPI_PAYEE_NAME=Threadline

# SMS + email for OTPs and order codes. Every code is generated by the API and sent as a normal SMS/email.
# SMS: SMS_PROVIDER=fast2sms with FAST2SMS_API_KEY (Fast2SMS dashboard > Dev API), or android (see below).
# Email: SMTP_* above. For Gmail use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and an App Password.
# fast2sms or android (your own phone, see below)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
# Android phone as a free SMS gateway: texts go out from your own SIM, no SMS company or fees. Install
# "SMS Gateway for Android" (https://sms-gate.app) on a phone with an SMS plan, turn on Local Server, and copy the
# address, username and password it shows. The phone must stay on, on the same Wi-Fi as this computer. With
# SMS_PROVIDER=android every SMS uses the phone, sign-up/login codes included. Test with: npm run sms:test -- 98XXXXXXXX
ANDROID_SMS_URL=
ANDROID_SMS_USER=
ANDROID_SMS_PASSWORD=
# Until real credentials are set, print messages in the API console instead (ignored in production).
OTP_DEV_CONSOLE=false

# PhonePe payment gateway (UPI checkout). Client ID / secret / version from the PhonePe Business dashboard,
# Developer Settings. PHONEPE_ENV=sandbox for test keys, production for live keys.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=sandbox

# ---- Shop settings (change here, then restart the APIs). Blank or invalid values use the default shown. ----
# Read by shared/settings.js; the storefront gets the customer-facing ones from the customer API (/api/shop-settings).
# Customer accounts: allowed sign-up email domain, password length, days a login lasts
CUSTOMER_EMAIL_DOMAIN=gmail.com
CUSTOMER_PASSWORD_MIN_LENGTH=8
CUSTOMER_SESSION_DAYS=7
# Wrong passwords: FIRST_ATTEMPTS tries lock for FIRST_MINUTES, then SECOND_ATTEMPTS more lock for SECOND_MINUTES
LOGIN_LOCK_FIRST_ATTEMPTS=3
LOGIN_LOCK_FIRST_MINUTES=1
LOGIN_LOCK_SECOND_ATTEMPTS=2
LOGIN_LOCK_SECOND_MINUTES=5
# Delivery area: PIN codes starting with DELIVERY_PIN_PREFIX; city/state pre-fill new addresses
DELIVERY_PIN_PREFIX=560
DELIVERY_AREA_NAME=Bangalore
DELIVERY_CITY=Bengaluru
DELIVERY_STATE=Karnataka
# Checkout (rupees): free delivery from this subtotal, otherwise DELIVERY_FEE; GST % on subtotal + delivery
FREE_DELIVERY_FROM=1499
DELIVERY_FEE=99
GST_PERCENT=18
# Minutes an item stays reserved in the bag; days after delivery a return can be requested
BAG_HOLD_MINUTES=30
RETURN_WINDOW_DAYS=7
# Sign-up/login codes: minutes a code is valid, wrong tries allowed
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Delivery partners: max open jobs one partner can hold
MAX_OPEN_JOBS_PER_PARTNER=5
# Admin's default product margin is not here: DEFAULT_MARGIN_PERCENT is in admin/backend/.env (the admin API reads that file)
