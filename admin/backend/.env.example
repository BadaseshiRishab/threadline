NODE_ENV=development
SERVICE_PORT=4002
FRONTEND_ORIGIN=http://localhost:5174
MONGODB_URI=mongodb://127.0.0.1:27017/threadline
JWT_SECRET=generate-a-unique-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
DATA_ENCRYPTION_KEY=use-the-same-base64-32-byte-key-as-seller
PRIVATE_UPLOADS_DIR=../../private_uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
# SMS + email for OTPs and order codes. Every code is generated by the API and sent as a normal SMS/email.
# SMS: SMS_PROVIDER=fast2sms with FAST2SMS_API_KEY (Fast2SMS dashboard > Dev API), or android (see below).
# Email: SMTP_* above. For Gmail use SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true and an App Password.
# fast2sms or android (your own phone, see the README)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=
# Until real credentials are set, print messages in the API console instead (ignored in production).
OTP_DEV_CONSOLE=false
OTP_SECRET=generate-a-separate-random-secret-of-at-least-32-characters
