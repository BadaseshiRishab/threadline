# Serves one website and forwards its API calls. ${API_UPSTREAM} (e.g. seller-api:4001) comes from docker-compose.
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  # Delivery partners upload a licence and an RC of up to 5 MB each.
  client_max_body_size 12m;

  # Look the API up through Docker's DNS on each request (cached 10 s) rather than once at startup, so a restarted
  # API container with a new address is found again.
  resolver 127.0.0.11 valid=10s ipv6=off;
  set $api_upstream http://${API_UPSTREAM};

  location /api/ {
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
  }

  location /uploads/ {
    proxy_pass $api_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Hashed bundles never change, so browsers may keep them; index.html is always re-checked.
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Single-page app: unknown paths (e.g. /orders) load index.html and the app's router takes over.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
